# Скопіюй у .env і заповни. .env у git не комітиться (див. .gitignore).

# Адреса форми. За замовчуванням - локальний макет для безпечної перевірки.
# Щоб працювати з реальною формою, постав її адресу тут і звір селектори у config.py.
FORM_URL=http://127.0.0.1:5000/mock-form

# Капчу і фінальний сабміт завжди робить людина у відкритому вікні браузера.
# HEADLESS=false - вікно видно (інакше людина не вирішить капчу). Не став true для реальної форми.
HEADLESS=false

# Пауза між відправками, секунди (щоб не бити по сервісу).
RATE_LIMIT_SECONDS=3

# Скільки разів повторювати лише ТИМЧАСОВІ збої (таймаут, 5xx).
MAX_ATTEMPTS=3

# Скільки секунд чекати, поки людина вирішить капчу і натисне Submit.
HUMAN_CONFIRM_TIMEOUT=180

# Порт веб-інтерфейсу.
PORT=5000

# ВАЖЛИВО: ключа 2captcha тут немає і не буде. Обхід капчі в цьому тулі не реалізований свідомо (див. README).
